<form method="post" action="{{ path('admin_customer_order_delete', ['id' => order.id]) }}" onsubmit="return confirm('Are you sure you want to delete this order? This action cannot be undone.');" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
    <button type="submit" class="btn btn-danger">Delete</button>
</form>
