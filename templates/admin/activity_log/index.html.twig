{% extends 'admin/partials/layout.html.twig' %}

{% block title %}Activity Logs{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4">Activity Logs</h1>
    </div>
    
    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" action="{{ path('admin_activity_log_index') }}" class="row g-3">
                <div class="col-md-3">
                    <label for="user" class="form-label">User</label>
                    <select name="user" id="user" class="form-control">
                        <option value="">All Users</option>
                        {% for user in users %}
                            <option value="{{ user.id }}" {{ currentFilters.user|default('') == user.id|default('') ? 'selected' : '' }}>
                                {{ user.email }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="action" class="form-label">Action</label>
                    <select name="action" id="action" class="form-control">
                        <option value="">All Actions</option>
                        <option value="LOGIN" {{ currentFilters.action == 'LOGIN' ? 'selected' : '' }}>Login</option>
                        <option value="LOGOUT" {{ currentFilters.action == 'LOGOUT' ? 'selected' : '' }}>Logout</option>
                        <option value="CREATE" {{ currentFilters.action == 'CREATE' ? 'selected' : '' }}>Create</option>
                        <option value="UPDATE" {{ currentFilters.action == 'UPDATE' ? 'selected' : '' }}>Update</option>
                        <option value="DELETE" {{ currentFilters.action == 'DELETE' ? 'selected' : '' }}>Delete</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="date_from" class="form-label">Date From</label>
                    <input type="date" name="date_from" id="date_from" class="form-control" value="{{ currentFilters.date_from }}">
                </div>
                <div class="col-md-2">
                    <label for="date_to" class="form-label">Date To</label>
                    <input type="date" name="date_to" id="date_to" class="form-control" value="{{ currentFilters.date_to }}">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-dark w-100">Filter</button>
                </div>
            </form>
        </div>
    </div>
    
    {% set headers = ['ID', 'User', 'Action', 'Entity Type', 'Entity ID', 'Description', 'Date/Time'] %}
    {% set rows = [] %}
    
    {% for log in logs %}
        {% set userEmail = log.user ? log.user.email : 'System/Unknown' %}
        {% set row = [
            log.id,
            userEmail,
            '<span class="badge badge-admin-' ~ (log.action == 'LOGIN' or log.action == 'LOGOUT' ? 'info' : (log.action == 'CREATE' ? 'success' : (log.action == 'UPDATE' ? 'warning' : 'danger'))) ~ '">' ~ log.action ~ '</span>',
            log.entityType ?? 'N/A',
            log.entityId ?? 'N/A',
            log.description ?? 'N/A',
            log.createdAt ? log.createdAt|date('Y-m-d H:i:s') : 'N/A'
        ] %}
        {% set rows = rows|merge([row]) %}
    {% endfor %}
    
    <div class="card shadow-sm mb-4">
        <div class="card-body p-0 overflow-x-auto">
            <table id="activityLogsTable" class="table table-striped table-hover mb-0" style="width: 100%;">
                <thead>
                    <tr>
                        {% for header in headers %}
                            <th class="text-left">{{ header }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% if logs|length == 0 %}
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No activity logs found.</td>
                        </tr>
                    {% else %}
                        {% for row in rows %}
                            <tr>
                                {% for cell in row %}
                                    <td>{{ cell|raw }}</td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
    
    <style>
        #activityLogsTable {
            width: 100% !important;
            margin: 0 !important;
            border-collapse: collapse;
        }
        #activityLogsTable thead th {
            border: 1px solid var(--admin-border) !important;
            border-width: 0 0 1px 0 !important;
            background-color: var(--admin-table-header) !important;
            color: var(--admin-text-white) !important;
            font-weight: 500;
            padding: 0.75rem 1rem;
            white-space: nowrap;
        }
        #activityLogsTable tbody td {
            border: 1px solid var(--admin-border-lighter) !important;
            border-width: 0 0 1px 0 !important;
            padding: 0.75rem 1rem;
        }
        #activityLogsTable tbody tr:hover {
            background-color: var(--admin-bg-light) !important;
        }
        #activityLogsTable tbody tr:nth-child(even) {
            background-color: var(--admin-white);
        }
        #activityLogsTable tbody tr:nth-child(odd) {
            background-color: var(--admin-bg-lighter);
        }
        .card-body.p-0 {
            padding: 0 !important;
        }
        .overflow-x-auto {
            overflow-x: auto;
        }
    </style>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
    window.addEventListener('load', function() {
        if (typeof jQuery !== 'undefined' && typeof jQuery.fn.DataTable !== 'undefined') {
            var $table = jQuery('#activityLogsTable');
            if ($table.length && !jQuery.fn.DataTable.isDataTable('#activityLogsTable')) {
                $table.DataTable({
                "pageLength": 25,
                "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                "ordering": true,
                "order": [[6, "desc"]], // Sort by date descending
                "searching": true,
                "paging": true,
                "info": true,
                "autoWidth": false,
                "responsive": false,
                "scrollX": true,
                "scrollCollapse": true,
                "fixedColumns": false,
                "language": {
                    "search": "Search:",
                    "lengthMenu": "Show _MENU_ entries",
                    "info": "Showing _START_ to _END_ of _TOTAL_ entries",
                    "infoEmpty": "Showing 0 to 0 of 0 entries",
                    "infoFiltered": "(filtered from _MAX_ total entries)",
                    "zeroRecords": "No matching records found",
                    "emptyTable": "No data available in table",
                    "paginate": {
                        "first": "First",
                        "last": "Last",
                        "next": "Next",
                        "previous": "Previous"
                    }
                },
                "dom": '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rt<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>'
            });
        }
    });
</script>
{% endblock %}

