{# templates/admin/partials/layout.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin Panel{% endblock %}</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Color Palette -->
    {% include 'admin/partials/_color_palette.html.twig' %}

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(165deg, var(--rain-warm-white) 0%, var(--rain-blush) 42%, #efe6e1 100%);
            overflow-x: hidden;
        }

        /* Sidebar Styles */
        #sidebar {
            min-width: 280px;
            max-width: 280px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: linear-gradient(180deg, #2a1620 0%, #241a22 38%, #1a1d23 100%);
            color: #fff;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow-y: auto;
            overflow-x: hidden;
            z-index: 1000;
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
        }

        #sidebar::-webkit-scrollbar {
            width: 6px;
        }

        #sidebar::-webkit-scrollbar-track {
            background: #1a1d23;
        }

        #sidebar::-webkit-scrollbar-thumb {
            background: #495057;
            border-radius: 3px;
        }

        #sidebar::-webkit-scrollbar-thumb:hover {
            background: #6c757d;
        }

        .sidebar-header {
            padding: 1.5rem 1.25rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(0, 0, 0, 0.2);
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.5rem;
        }

        .sidebar-logo img {
            width: 45px;
            height: 45px;
            border-radius: 8px;
            object-fit: cover;
        }

        .sidebar-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #fff;
            margin: 0;
        }

        .sidebar-subtitle {
            font-size: 0.75rem;
            color: #adb5bd;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        #sidebar .nav {
            padding: 1rem 0.75rem;
            flex: 1;
        }

        #sidebar .nav-item {
            margin-bottom: 0.25rem;
        }

        #sidebar .nav-link {
            color: #adb5bd;
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.2s ease;
            font-weight: 500;
            font-size: 0.95rem;
            position: relative;
        }

        #sidebar .nav-link i {
            font-size: 1.1rem;
            width: 20px;
            text-align: center;
        }

        #sidebar .nav-link:hover {
            color: #fff;
            background-color: rgba(255, 255, 255, 0.08);
            transform: translateX(4px);
        }

        #sidebar .nav-link.active {
            color: #fff;
            background: linear-gradient(135deg, #5c3040 0%, #3d2530 100%);
            box-shadow: 0 2px 10px rgba(122, 37, 53, 0.35);
        }

        #sidebar .nav-link.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 3px;
            height: 60%;
            background: linear-gradient(180deg, #e8b4b4 0%, var(--rain-wine) 100%);
            border-radius: 0 3px 3px 0;
        }

        /* Content Area */
        #content {
            margin-left: 280px;
            min-height: 100vh;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            padding: 1rem 1.25rem 1.5rem;
            width: calc(100% - 280px);
            max-width: calc(100vw - 280px);
            box-sizing: border-box;
            overflow-x: hidden;
            background: transparent;
        }

        /* Wide / landscape workspace: data-table style lists, full-width detail panels */
        .admin-workspace {
            width: 100%;
            max-width: 100%;
        }

        .admin-table-scroll {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .admin-table-scroll .dataTables_wrapper {
            width: 100% !important;
        }

        table.dataTable {
            width: 100% !important;
        }

        .admin-detail-panel .card {
            width: 100%;
        }

        .admin-detail-panel .show-details-table {
            table-layout: fixed;
            width: 100%;
        }

        @media (min-width: 992px) {
            .admin-detail-panel .show-details-table th {
                width: 15%;
                min-width: 110px;
                max-width: 260px;
            }
            .admin-detail-panel .show-details-table td {
                word-wrap: break-word;
            }
        }

        /* Top Navbar */
        .top-navbar {
            background: linear-gradient(90deg, #ffffff 0%, rgba(255, 255, 255, 0.97) 100%);
            box-shadow: 0 2px 12px rgba(122, 37, 53, 0.08);
            padding: 1rem 1.5rem;
            margin-bottom: 1.5rem;
            border-radius: 0.5rem;
            width: 100%;
            border-left: 4px solid var(--rain-wine);
        }

        .navbar-brand-mobile {
            display: none;
            font-weight: 600;
            color: #212529;
            font-size: 1rem;
        }

        #sidebarCollapse {
            display: none;
            background: #212529;
            border: none;
            color: #fff;
            padding: 0.5rem 0.75rem;
            border-radius: 0.375rem;
            transition: all 0.2s ease;
            flex-shrink: 0;
        }

        #sidebarCollapse:hover {
            background: #343a40;
            transform: scale(1.05);
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--rain-wine) 0%, var(--rain-wine-dark) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 600;
            font-size: 0.9rem;
            flex-shrink: 0;
        }

        .user-details {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .user-email {
            font-weight: 500;
            color: #212529;
            font-size: 0.95rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 200px;
        }

        .user-role {
            font-size: 0.75rem;
            color: #6c757d;
            text-transform: capitalize;
        }

        .logout-btn {
            background: #dc3545;
            border: none;
            color: #fff;
            padding: 0.5rem 1rem;
            border-radius: 0.375rem;
            font-weight: 500;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .logout-btn:hover {
            background: #c82333;
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(220, 53, 69, 0.3);
        }

        /* Sidebar Overlay for Mobile */
        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .sidebar-overlay.show {
            opacity: 1;
        }

        /* Responsive Styles */
        @media (max-width: 992px) {
            #sidebar {
                margin-left: -280px;
                box-shadow: 2px 0 20px rgba(0, 0, 0, 0.3);
            }

            #sidebar.show {
                margin-left: 0;
            }

            .sidebar-overlay {
                display: block;
            }

            .sidebar-overlay.show {
                display: block;
            }

            #sidebarCollapse {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
            }

            .navbar-brand-mobile {
                display: inline-block;
            }

            #content {
                margin-left: 0;
                width: 100%;
                max-width: 100vw;
                padding: 1rem 0.75rem;
            }

            .top-navbar {
                padding: 0.75rem 1rem;
                margin-bottom: 1rem;
            }

            .user-info {
                gap: 0.75rem;
                width: 100%;
                justify-content: space-between;
            }

            .user-details {
                display: none;
            }

            .user-email {
                max-width: 150px;
            }

            .logout-btn {
                padding: 0.5rem 0.75rem;
            }

            .logout-btn span {
                display: none;
            }

            .top-navbar > div {
                gap: 1rem !important;
            }
        }

        /* Sidebar Footer */
        .sidebar-footer {
            margin-top: auto;
            padding: 1.25rem;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(0, 0, 0, 0.2);
        }

        .sidebar-footer-content {
            text-align: center;
        }

        .sidebar-footer-version {
            font-size: 0.75rem;
            color: #6c757d;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .sidebar-footer-version i {
            color: #495057;
        }

        .sidebar-footer-copyright {
            font-size: 0.7rem;
            color: #495057;
            margin-bottom: 0.75rem;
        }

        .sidebar-footer-divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            margin: 0.75rem 0;
        }

        .sidebar-footer-links {
            display: flex;
            justify-content: center;
            gap: 1rem;
            margin-top: 0.75rem;
        }

        .sidebar-footer-link {
            color: #6c757d;
            font-size: 0.85rem;
            text-decoration: none;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }

        .sidebar-footer-link:hover {
            color: #fff;
            transform: translateY(-1px);
        }

        .sidebar-footer-link i {
            font-size: 0.9rem;
        }

        .sidebar-footer-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.25rem 0.5rem;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 0.375rem;
            font-size: 0.7rem;
            color: #adb5bd;
            margin-top: 0.5rem;
        }

        .sidebar-footer-badge i {
            color: #198754;
        }

        @media (max-width: 576px) {
            #sidebar {
                min-width: 100%;
                max-width: 100%;
            }

            .top-navbar {
                padding: 0.75rem;
            }

            .sidebar-footer {
                padding: 1rem;
            }
        }
    </style>
</head>
<body data-route="{{ app.request.attributes.get('_route') }}">
    <!-- Sidebar Overlay (Mobile) -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Sidebar -->
    <nav id="sidebar" class="bg-dark">
        <div class="sidebar-header">
            <div class="sidebar-logo">
                <img src="{{ asset('images/logo.png') }}" alt="Logo">
                <div>
                    <h6 class="sidebar-title">Designer Shoes</h6>
                    <div class="sidebar-subtitle">
                        {% if is_granted('ROLE_ADMIN') %}
                            Admin Panel
                        {% elseif is_granted('ROLE_STAFF') %}
                            Staff Panel
                        {% else %}
                            Panel
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        <ul class="nav nav-pills flex-column">
            {% if is_granted('ROLE_ADMIN') %}
                <li class="nav-item">
                    <a href="{{ path('admin_dashboard') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_dashboard' ? 'active' : '' }}">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('admin_user_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_user' ? 'active' : '' }}">
                        <i class="bi bi-people"></i>
                        <span>Users</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('admin_service_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_service' ? 'active' : '' }}">
                        <i class="bi bi-tools"></i>
                        <span>Services</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('admin_customer_order_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_customer_order' ? 'active' : '' }}">
                        <i class="bi bi-cart-check"></i>
                        <span>Orders</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('admin_product_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_product' ? 'active' : '' }}">
                        <i class="bi bi-box-seam"></i>
                        <span>Products</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('admin_stock_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_stock' ? 'active' : '' }}">
                        <i class="bi bi-boxes"></i>
                        <span>Stock</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('admin_activity_log_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_activity_log' ? 'active' : '' }}">
                        <i class="bi bi-clock-history"></i>
                        <span>Activity Logs</span>
                    </a>
                </li>
            {% elseif is_granted('ROLE_STAFF') %}
                <li class="nav-item">
                    <a href="{{ path('admin_dashboard') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_dashboard' ? 'active' : '' }}">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('admin_service_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_service' ? 'active' : '' }}">
                        <i class="bi bi-tools"></i>
                        <span>Services</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('admin_customer_order_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_customer_order' ? 'active' : '' }}">
                        <i class="bi bi-cart-check"></i>
                        <span>Orders</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('admin_product_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_product' ? 'active' : '' }}">
                        <i class="bi bi-box-seam"></i>
                        <span>Products</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('admin_stock_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'admin_stock' ? 'active' : '' }}">
                        <i class="bi bi-boxes"></i>
                        <span>Stock</span>
                    </a>
                </li>
            {% endif %}
            {% if app.user %}
                <li class="nav-item">
                    <a href="{{ path('profile_show') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'profile' ? 'active' : '' }}">
                        <i class="bi bi-person-circle"></i>
                        <span>My Profile</span>
                    </a>
                </li>
            {% endif %}
        </ul>
        
        <!-- Sidebar Footer -->
        <div class="sidebar-footer">
            <div class="sidebar-footer-content">
                <div class="sidebar-footer-divider"></div>
                <div class="sidebar-footer-version">
                    <i class="bi bi-code-slash"></i>
                    <span>Version 1.0.0</span>
                </div>
                <div class="sidebar-footer-badge">
                    <i class="bi bi-shield-check"></i>
                    <span>Secure</span>
                </div>
                <div class="sidebar-footer-copyright">
                    © {{ "now"|date("Y") }} Designer Shoes
                </div>
                <div class="sidebar-footer-links">
                    <a href="{{ path('profile_show') }}" class="sidebar-footer-link" title="Profile">
                        <i class="bi bi-person"></i>
                        <span>Profile</span>
                    </a>
                    <a href="{{ path('logout') }}" class="sidebar-footer-link" title="Logout">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Logout</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Page Content -->
    <div id="content">
        <!-- Top Navbar -->
        <nav class="top-navbar">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center w-100 gap-3">
                <div class="d-flex align-items-center gap-3 w-100 w-md-auto">
                    <button type="button" id="sidebarCollapse" class="btn">
                        <i class="bi bi-list"></i>
                    </button>
                    <span class="navbar-brand-mobile">Designer Shoes Admin</span>
                </div>
                <div class="user-info w-100 w-md-auto justify-content-end">
                    {% if is_granted('ROLE_STAFF') %}
                        <div class="dropdown" id="realtime-bell">
                            <button
                                class="btn btn-sm btn-outline-secondary position-relative"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                aria-label="Notifications"
                                title="Notifications"
                            >
                                <i class="bi bi-bell"></i>
                                <span
                                    class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none"
                                    id="realtime-bell-badge"
                                >0</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end p-0 shadow" style="min-width: 320px; max-width: 420px;">
                                <div id="realtime-bell-status" class="small px-3 py-1 border-bottom text-muted">Connecting…</div>
                                <div class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center">
                                    <strong>Notifications</strong>
                                    <button class="btn btn-sm btn-link text-decoration-none" type="button" id="realtime-bell-clear">Clear</button>
                                </div>
                                <div id="realtime-bell-list" class="list-group list-group-flush" style="max-height: 360px; overflow: auto;">
                                    <div class="list-group-item text-muted small">Waiting for live events…</div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                    {% if app.user %}
                        <div class="user-avatar">
                            {{ app.user.email|first|upper }}
                        </div>
                        <div class="user-details">
                            <div class="user-email">{{ app.user.email }}</div>
                            <div class="user-role">{{ app.user.roles|first|replace({'ROLE_': ''})|lower }}</div>
                        </div>
                    {% else %}
                        <span class="text-muted">Guest</span>
                    {% endif %}
                    <a href="{{ path('logout') }}" class="logout-btn">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Logout</span>
                    </a>
                </div>
            </div>
        </nav>

        <!-- Flash Messages -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <!-- Main content -->
        {% block body %}{% endblock %}
    </div>

    <!-- jQuery (required for DataTables) -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    
    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('sidebarCollapse');
        const overlay = document.getElementById('sidebarOverlay');

        // Toggle sidebar
        if (toggleBtn) {
            toggleBtn.addEventListener('click', () => {
                sidebar.classList.toggle('show');
                if (overlay) {
                    overlay.classList.toggle('show');
                }
            });
        }

        // Close sidebar when clicking overlay
        if (overlay) {
            overlay.addEventListener('click', () => {
                sidebar.classList.remove('show');
                overlay.classList.remove('show');
            });
        }

        // Close sidebar on window resize if it's desktop size
        window.addEventListener('resize', () => {
            if (window.innerWidth > 992) {
                sidebar.classList.remove('show');
                if (overlay) {
                    overlay.classList.remove('show');
                }
            }
        });

        // Close sidebar when clicking outside on mobile
        document.addEventListener('click', (e) => {
            if (window.innerWidth <= 992 && 
                sidebar.classList.contains('show') && 
                !sidebar.contains(e.target) && 
                !toggleBtn.contains(e.target)) {
                sidebar.classList.remove('show');
                if (overlay) {
                    overlay.classList.remove('show');
                }
            }
        });

    </script>

    {% if is_granted('ROLE_STAFF') %}
    {% set realtime_js_v = '2026052911' %}
    <script src="{{ asset('js/realtime-bell.js') ~ '?v=' ~ realtime_js_v }}" defer></script>
    <script src="{{ asset('js/realtime-notifications.js') ~ '?v=' ~ realtime_js_v }}" defer></script>
    <script src="{{ asset('js/realtime-dashboard-sync.js') ~ '?v=' ~ realtime_js_v }}" defer></script>
    {% endif %}

    {% block scripts %}{% endblock %}
</body>
</html>
