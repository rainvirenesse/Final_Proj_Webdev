{# DataTables and Tailwind are already loaded in layout.html.twig #}

<style>
    /* Modern sharp design with subtle shadows */
    #{{ tableId }} {
        border: none !important;
        border-collapse: separate !important;
        border-spacing: 0 !important;
    }

    /* Header: same warm blush tone as the main panel / sidebar edge */
    #{{ tableId }} thead th {
        border: none !important;
        background: linear-gradient(180deg, var(--rain-blush) 0%, var(--rain-warm-white) 55%, #f7f0ec 100%) !important;
        color: var(--rain-wine-dark) !important;
        font-weight: 600;
        font-size: 0.8125rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 1rem 1.25rem 1rem 1.25rem;
        position: relative;
        box-shadow: inset 0 -1px 0 rgba(122, 37, 53, 0.15);
        text-shadow: none;
    }

    #{{ tableId }} thead th:first-child {
        padding-left: 1.85rem;
        border-radius: 0.5rem 0 0 0;
    }

    #{{ tableId }} thead th:not(:last-child) {
        box-shadow: inset -1px 0 0 rgba(122, 37, 53, 0.12), inset 0 -1px 0 rgba(122, 37, 53, 0.15);
    }

    #{{ tableId }} thead th:last-child {
        border-radius: 0 0.5rem 0 0;
    }

    /* DataTables sort carets — readable on light header */
    #{{ tableId }} thead th.sorting:before,
    #{{ tableId }} thead th.sorting:after,
    #{{ tableId }} thead th.sorting_asc:before,
    #{{ tableId }} thead th.sorting_asc:after,
    #{{ tableId }} thead th.sorting_desc:before,
    #{{ tableId }} thead th.sorting_desc:after {
        color: var(--rain-wine) !important;
        opacity: 0.65;
    }

    #{{ tableId }} tbody td {
        border: none !important;
        border-bottom: 1px solid #f1f3f5 !important;
        padding: 1rem 1.25rem;
        font-size: 0.9375rem;
        color: var(--admin-text-dark);
    }

    #{{ tableId }} tbody tr {
        border: none !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        background-color: var(--admin-white);
    }

    #{{ tableId }} tbody tr:hover {
        background-color: #f8fafc !important;
        transform: translateX(2px);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    #{{ tableId }} tbody tr:last-child td {
        border-bottom: none !important;
    }

    #{{ tableId }} tbody tr:last-child td:first-child {
        border-radius: 0 0 0 0.5rem;
    }

    #{{ tableId }} tbody tr:last-child td:last-child {
        border-radius: 0 0 0.5rem 0;
    }

    /* Remove thick outer borders */
    .dataTables_wrapper {
        border: none !important;
    }

    /* DataTables controls styling - consistent theme */
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter,
    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate {
        color: var(--admin-text-dark);
        font-size: 0.875rem;
    }

    /* Top controls container */
    .dataTables_wrapper .dataTables_length {
        float: left;
        padding: 1rem 1.5rem;
    }

    .dataTables_wrapper .dataTables_filter {
        float: right;
        padding: 1rem 1.5rem;
    }

    .dataTables_wrapper .dataTables_filter input {
        margin-left: 0.5rem;
        padding: 0.375rem 0.75rem;
        border: 1px solid var(--admin-border-light);
        border-radius: 0.375rem;
        font-size: 0.875rem;
    }

    .dataTables_wrapper .dataTables_filter input:focus {
        outline: none;
        border-color: var(--admin-table-header);
    }

    .dataTables_wrapper .dataTables_length select {
        padding: 0.375rem 2rem 0.375rem 0.75rem;
        border: 1px solid var(--admin-border-light);
        border-radius: 0.375rem;
        font-size: 0.875rem;
        margin: 0 0.5rem;
    }

    /* Bottom info and pagination */
    .dataTables_wrapper .dataTables_info {
        float: left;
        padding: 1rem 1.5rem;
        color: var(--admin-text-muted);
    }

    .dataTables_wrapper .dataTables_paginate {
        float: right;
        padding: 1rem 1.5rem;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button.current {
        background: var(--admin-table-header) !important;
        border-color: var(--admin-table-header) !important;
        color: var(--admin-text-white) !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button:hover:not(.disabled) {
        background: var(--admin-table-header-hover) !important;
        border-color: var(--admin-table-header-hover) !important;
        color: var(--admin-text-white) !important;
    }

    /* Clear floats */
    .dataTables_wrapper::after {
        content: "";
        display: table;
        clear: both;
    }

    /* Card styling */
    .card {
        border: 1px solid var(--admin-border);
        border-radius: 0.5rem;
        overflow: hidden;
    }

    /* Disable auto-width for Actions column */
    #{{ tableId }} th:last-child,
    #{{ tableId }} td:last-child {
        width: 1%;
        white-space: nowrap;
    }
    
    /* Button styling in tables */
    #{{ tableId }} .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
        line-height: 1.5;
        margin: 0 2px;
    }
    
    #{{ tableId }} .d-flex.gap-1 > * {
        margin-right: 0.25rem;
    }
    
    #{{ tableId }} .d-flex.gap-1 > *:last-child {
        margin-right: 0;
    }
</style>

<div class="card shadow-sm mb-4 admin-datatable-card">
    <div class="card-body p-0 admin-table-scroll admin-table-scroll--inset">
        <table id="{{ tableId }}" class="w-full">
            <thead>
                <tr>
                    {% for header in headers %}
                        <th class="text-left">{{ header }}</th>
                    {% endfor %}
                    <th class="text-left w-1">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        {% for cell in row %}
                            <td>{{ cell|raw }}</td>
                        {% endfor %}
                        <td style="white-space: nowrap;">
                            <div class="d-flex gap-1">
                                <a href="{{ path(editRoute, {'id': row[0]}) }}" 
                                   class="btn btn-sm btn-dark">
                                    Edit
                                </a>
                                <a href="{{ path(showRoute, {'id': row[0]}) }}" 
                                   class="btn btn-sm btn-outline-secondary">
                                    View
                                </a>
                                <form method="post"
                                      action="{{ path(deleteRoute, {'id': row[0]}) }}"
                                      class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ row[0]) }}">
                                    <button type="submit"
                                            onclick="return confirm('Are you sure you want to delete this item?');"
                                            class="btn btn-sm btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script>
    // Wait for jQuery and DataTables to load, then initialize table
    window.addEventListener('load', function() {
        function initTable() {
            if (typeof jQuery !== 'undefined' && typeof jQuery.fn !== 'undefined' && typeof jQuery.fn.DataTable !== 'undefined') {
                var tableId = '{{ tableId }}';
                var $table = jQuery('#' + tableId);
                if ($table.length > 0 && !jQuery.fn.DataTable.isDataTable('#' + tableId)) {
                    $table.DataTable({
                        "pageLength": 10,
                        "lengthMenu": [[5, 10, 25, 50, -1], [5, 10, 25, 50, "All"]],
                        "ordering": true,
                        "order": {{ dtOrder|default([[0, 'asc']])|json_encode|raw }},
                        "searching": true,
                        "paging": true,
                        "info": true,
                        "autoWidth": false,
                        "responsive": false,
                        "scrollX": true,
                        "scrollCollapse": true,
                        "language": {
                            "search": "Search:",
                            "lengthMenu": "Show _MENU_ entries",
                            "info": "Showing _START_ to _END_ of _TOTAL_ entries",
                            "infoEmpty": "Showing 0 to 0 of 0 entries",
                            "infoFiltered": "(filtered from _MAX_ total entries)",
                            "zeroRecords": "No matching records found",
                            "emptyTable": "No data available in table",
                            "paginate": {
                                "first": "First",
                                "last": "Last",
                                "next": "Next",
                                "previous": "Previous"
                            }
                        },
                        "dom": '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rt<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                        "columnDefs": [
                            {
                                "targets": -1,
                                "orderable": false,
                                "searchable": false
                            }
                        ]
                    });
                }
            } else {
                // Retry if jQuery/DataTables not loaded yet
                setTimeout(initTable, 100);
            }
        }
        initTable();
    });
</script>