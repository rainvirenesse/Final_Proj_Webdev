{# Admin Color Palette - Consistent Design System #}
<style>
    /* ============================================
       ADMIN COLOR PALETTE
       ============================================ */
    
    /* Primary Colors */
    :root {
        /* RAIN storefront palette (shared accent) */
        --rain-wine: #7a2535;
        --rain-wine-dark: #5c1a27;
        --rain-blush: #f3e8e2;
        --rain-blush-mid: #e8d5cc;
        --rain-warm-white: #faf6f3;
        --rain-taupe: #b59a8e;
        --admin-dark: #212529;        /* Sidebar background */
        --admin-dark-hover: #343a40;   /* Sidebar hover/active */
        --admin-table-header: #2d1820; /* Wine-tinted table header */
        --admin-table-header-hover: #43202a; /* Table header hover */
        
        /* Neutral Colors */
        --admin-white: #ffffff;
        --admin-bg-light: #f9fafb;
        --admin-bg-lighter: #fafafa;
        
        /* Border Colors */
        --admin-border: #e5e7eb;
        --admin-border-light: #d1d5db;
        --admin-border-lighter: #f3f4f6;
        
        /* Text Colors */
        --admin-text-dark: #374151;
        --admin-text-muted: #6b7280;
        --admin-text-light: #adb5bd;
        --admin-text-white: #ffffff;
        
        /* Accent Colors */
        --admin-success: #10b981;
        --admin-warning: #f59e0b;
        --admin-danger: #ef4444;
        --admin-info: #3b82f6;
    }
    
    /* Consistent Card Styling */
    .admin-card {
        border: 1px solid var(--admin-border);
        border-radius: 0.5rem;
        background: var(--admin-white);
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
    }
    
    .admin-card-header {
        background: var(--admin-white);
        border-bottom: 1px solid var(--admin-border);
        padding: 1rem 1.5rem;
    }
    
    /* Consistent Button Styling */
    .btn-admin-primary {
        background-color: var(--admin-table-header);
        border-color: var(--admin-table-header);
        color: var(--admin-text-white);
    }
    
    .btn-admin-primary:hover {
        background-color: var(--admin-table-header-hover);
        border-color: var(--admin-table-header-hover);
        color: var(--admin-text-white);
    }
    
    /* Consistent Badge Styling */
    .badge-admin-success {
        background-color: var(--admin-success);
        color: var(--admin-text-white);
    }
    
    .badge-admin-warning {
        background-color: var(--admin-warning);
        color: var(--admin-text-white);
    }
    
    .badge-admin-danger {
        background-color: var(--admin-danger);
        color: var(--admin-text-white);
    }
    
    .badge-admin-info {
        background-color: var(--admin-info);
        color: var(--admin-text-white);
    }

    /* Primary actions — brand wine instead of flat black */
    #content .btn-dark {
        background: linear-gradient(135deg, var(--rain-wine) 0%, var(--rain-wine-dark) 100%);
        border-color: var(--rain-wine-dark);
        color: var(--admin-text-white);
    }
    #content .btn-dark:hover,
    #content .btn-dark:focus {
        background: var(--rain-wine-dark);
        border-color: var(--rain-wine-dark);
        color: var(--admin-text-white);
    }

    /* Cards: soft wine edge + warmer shadow */
    #content .card {
        border-color: rgba(122, 37, 53, 0.14) !important;
        box-shadow: 0 4px 18px rgba(44, 32, 32, 0.07) !important;
    }
    #content .card.border-0 {
        border-top: 3px solid var(--rain-wine) !important;
    }

    /* Nudge datatable block right so headers aren’t flush to card edge */
    .admin-table-scroll--inset {
        padding-left: 0.75rem;
        padding-right: 0.5rem;
        box-sizing: border-box;
    }

    /*
     * DataTables + scrollX: the *visible* header is a cloned table inside
     * .dataTables_scrollHead — it does not keep the original id, so per-table
     * #myTable thead th rules never apply. Give the strip a real container + tint.
     */
    #content .admin-table-scroll div.dataTables_scroll {
        padding-top: 0.45rem;
    }

    #content .admin-table-scroll div.dataTables_scrollHead {
        background: linear-gradient(180deg, var(--rain-blush-mid) 0%, var(--rain-blush) 38%, var(--rain-warm-white) 100%);
        border: 1px solid rgba(122, 37, 53, 0.24);
        border-bottom: 1px solid rgba(122, 37, 53, 0.14);
        border-radius: 0.5rem 0.5rem 0 0;
        box-sizing: border-box;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55);
    }

    #content .admin-table-scroll div.dataTables_scrollHead table.dataTable {
        margin-top: 0 !important;
        margin-bottom: 0 !important;
    }

    #content .admin-table-scroll div.dataTables_scrollHead table.dataTable > thead > tr > th,
    #content .admin-table-scroll div.dataTables_scrollHead table.dataTable > thead > tr > td {
        background: transparent !important;
        color: var(--rain-wine-dark) !important;
        font-weight: 600;
        font-size: 0.8125rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 1rem 1.25rem !important;
        border: none !important;
        vertical-align: middle;
    }

    #content .admin-table-scroll div.dataTables_scrollHead table.dataTable > thead > tr > th:first-child,
    #content .admin-table-scroll div.dataTables_scrollHead table.dataTable > thead > tr > td:first-child {
        padding-left: 1.85rem !important;
    }

    #content .admin-table-scroll div.dataTables_scrollHead table.dataTable > thead > tr > th:not(:last-child),
    #content .admin-table-scroll div.dataTables_scrollHead table.dataTable > thead > tr > td:not(:last-child) {
        box-shadow: inset -1px 0 0 rgba(122, 37, 53, 0.12), inset 0 -1px 0 rgba(122, 37, 53, 0.12) !important;
    }

    #content .admin-table-scroll div.dataTables_scrollHead table.dataTable > thead > tr > th:last-child,
    #content .admin-table-scroll div.dataTables_scrollHead table.dataTable > thead > tr > td:last-child {
        box-shadow: inset 0 -1px 0 rgba(122, 37, 53, 0.12) !important;
    }

    #content .admin-table-scroll div.dataTables_scrollHead table.dataTable thead th.sorting:before,
    #content .admin-table-scroll div.dataTables_scrollHead table.dataTable thead th.sorting:after,
    #content .admin-table-scroll div.dataTables_scrollHead table.dataTable thead th.sorting_asc:before,
    #content .admin-table-scroll div.dataTables_scrollHead table.dataTable thead th.sorting_asc:after,
    #content .admin-table-scroll div.dataTables_scrollHead table.dataTable thead th.sorting_desc:before,
    #content .admin-table-scroll div.dataTables_scrollHead table.dataTable thead th.sorting_desc:after {
        color: var(--rain-wine) !important;
        opacity: 0.55;
    }
</style>

