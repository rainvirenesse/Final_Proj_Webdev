{% extends 'admin/partials/layout.html.twig' %}

{% block title %}Edit stock record{% endblock %}

{% block body %}
<div class="container-fluid py-3 admin-workspace">
    <div class="row">
        <div class="col-12 col-lg-10 col-xl-8 admin-detail-panel">
            <div class="card shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0 fw-semibold">Edit stock record #{{ record.id }}</h5>
                </div>
                <div class="card-body p-4">
                    {% include 'admin/stock/_form.html.twig' with {
                        'form': form,
                        'submit_label': 'Update record',
                        'cancel_path': path('admin_stock_index')
                    } %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
