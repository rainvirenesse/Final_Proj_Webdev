{% extends 'admin/partials/layout.html.twig' %}

{% block title %}My Profile{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12 col-md-8 col-lg-6 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-person-circle me-2"></i>My Profile
                    </h5>
                </div>
                <div class="card-body p-4">
                    <table class="table table-borderless mb-0 show-details-table">
                        <tr>
                            <th width="30%" class="text-muted fw-semibold">ID:</th>
                            <td class="fw-medium">{{ user.id }}</td>
                        </tr>
                        <tr>
                            <th class="text-muted fw-semibold">Username:</th>
                            <td>{{ user.username }}</td>
                        </tr>
                        <tr>
                            <th class="text-muted fw-semibold">Email:</th>
                            <td>{{ user.email }}</td>
                        </tr>
                        <tr>
                            <th class="text-muted fw-semibold">Roles:</th>
                            <td>
                                {% for role in user.roles %}
                                    <span class="badge bg-dark me-1 px-2 py-1">{{ role }}</span>
                                {% endfor %}
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted fw-semibold">Status:</th>
                            <td>
                                <span class="badge {{ user.status == 'ACTIVE' ? 'badge-admin-success' : (user.status == 'DISABLED' ? 'badge-admin-danger' : 'badge-admin-warning') }} px-3 py-1">
                                    {{ user.status }}
                                </span>
                            </td>
                        </tr>
                        {% if user.image %}
                        <tr>
                            <th class="text-muted fw-semibold">Profile Image:</th>
                            <td>
                                <img src="{{ asset(user.image) }}" class="rounded shadow-sm" style="width: 80px; height: 80px; object-fit: cover; border: 2px solid var(--admin-border);">
                            </td>
                        </tr>
                        {% endif %}
                        <tr>
                            <th class="text-muted fw-semibold">Created At:</th>
                            <td>{{ user.createdAt|date('Y-m-d H:i:s') }}</td>
                        </tr>
                        {% if user.updatedAt %}
                        <tr>
                            <th class="text-muted fw-semibold">Updated At:</th>
                            <td>{{ user.updatedAt|date('Y-m-d H:i:s') }}</td>
                        </tr>
                        {% endif %}
                    </table>
                </div>
                <div class="card-footer bg-white border-top">
                    <div class="d-flex gap-2 justify-content-end">
                        <a href="{{ path('profile_edit') }}" class="btn btn-dark">
                            <i class="bi bi-pencil me-2"></i>Edit Profile
                        </a>
                        <a href="{{ path('profile_change_password') }}" class="btn btn-outline-secondary">
                            <i class="bi bi-key me-2"></i>Change Password
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .show-details-table tr {
        border-bottom: 1px solid var(--admin-border-lighter);
        transition: background-color 0.2s ease;
    }
    .show-details-table tr:hover {
        background-color: var(--admin-bg-light);
    }
    .show-details-table tr:last-child {
        border-bottom: none;
    }
    .show-details-table th {
        padding: 1rem 1.25rem 1rem 0;
        vertical-align: middle;
    }
    .show-details-table td {
        padding: 1rem 0;
        vertical-align: middle;
        color: var(--admin-text-dark);
    }
    .card {
        border: 1px solid var(--admin-border);
        border-radius: 0.5rem;
    }
    .card-header {
        padding: 1.25rem 1.5rem;
    }
    .card-footer {
        padding: 1.25rem 1.5rem;
    }
    .card-header i {
        color: var(--admin-table-header);
    }
</style>
{% endblock %}

