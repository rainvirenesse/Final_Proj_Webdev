{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}
{% block navbar %}{% endblock %}
{% block footer %}{% endblock %}

{% block body_class %} class="page-auth"{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* Scoped so global rain.css / Encore never override this page */
        body.page-auth {
            background: linear-gradient(135deg, #1f2937 0%, #212529 50%, #343a40 100%) !important;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif !important;
            font-weight: 400;
            padding: 2rem;
            position: relative;
            overflow-x: hidden;
            color: rgba(255, 255, 255, 0.92);
            line-height: 1.5;
        }

        body.page-auth::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
            animation: pulse 15s ease-in-out infinite;
        }

        body.page-auth::after {
            content: '';
            position: absolute;
            bottom: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.1) 0%, transparent 70%);
            animation: pulse 20s ease-in-out infinite reverse;
        }
        
        @keyframes pulse {
            0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.5; }
            50% { transform: scale(1.1) rotate(180deg); opacity: 0.8; }
        }
        
        .auth-wrapper {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 1000px;
        }
        
        .auth-container {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1.5rem;
            padding: 3rem;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            display: flex;
            align-items: center;
            gap: 3rem;
        }
        
        .logo-section {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
        }
        
        .logo-section img {
            max-width: 200px;
            width: 100%;
            height: auto;
            filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
        }
        
        .divider {
            width: 1px;
            background: rgba(255, 255, 255, 0.2);
            align-self: stretch;
            margin: 1rem 0;
        }
        
        .auth-form {
            flex: 1;
        }
        
        .auth-header {
            text-align: center;
            margin-bottom: 2rem;
        }
        
        .auth-header h1 {
            color: #ffffff;
            font-weight: 700;
            font-size: 2rem;
            margin-bottom: 0.5rem;
            letter-spacing: -0.5px;
        }
        
        .auth-header p {
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.95rem;
            margin: 0;
        }
        
        body.page-auth .form-label {
            font-weight: 500;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 0.75rem;
            font-size: 0.9rem;
        }

        body.page-auth .form-control {
            background: rgba(255, 255, 255, 0.1) !important;
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            border-radius: 0.75rem;
            color: #ffffff !important;
            padding: 0.875rem 1.25rem;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

        body.page-auth .form-control::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        body.page-auth .form-control:focus {
            background: rgba(255, 255, 255, 0.15) !important;
            border-color: rgba(59, 130, 246, 0.5) !important;
            color: #ffffff !important;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            outline: none;
        }
        
        .btn-login {
            width: 100%;
            padding: 0.875rem;
            font-weight: 600;
            font-size: 1rem;
            background: linear-gradient(135deg, #1f2937 0%, #374151 100%);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #ffffff;
            border-radius: 0.75rem;
            transition: all 0.3s ease;
            margin-top: 0.5rem;
        }
        
        .btn-login:hover {
            background: linear-gradient(135deg, #374151 0%, #1f2937 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
            border-color: rgba(255, 255, 255, 0.3);
        }
        
        .btn-login:active {
            transform: translateY(0);
        }

        /* Google OAuth — neutral “Sign in with Google” treatment (works on dark glass card) */
        .btn-google {
            --btn-google-border: rgba(255, 255, 255, 0.22);
            --btn-google-shadow: 0 1px 2px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.08);
            width: 100%;
            min-height: 3rem;
            padding: 0.75rem 1.25rem;
            font-family: inherit;
            font-weight: 500;
            font-size: 0.9375rem;
            letter-spacing: 0.01em;
            line-height: 1.25;
            color: #1f1f1f !important;
            background: #ffffff;
            border: 1px solid var(--btn-google-border);
            border-radius: 0.75rem;
            box-shadow: var(--btn-google-shadow);
            transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            text-decoration: none !important;
            margin-top: 0.25rem;
            cursor: pointer;
            -webkit-tap-highlight-color: transparent;
        }

        .btn-google .btn-google__icon {
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-google:hover {
            color: #1f1f1f !important;
            background: #f8fafc;
            border-color: rgba(255, 255, 255, 0.35);
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.14), 0 4px 14px rgba(0, 0, 0, 0.1);
            transform: translateY(-1px);
        }

        .btn-google:focus-visible {
            outline: none;
            border-color: rgba(59, 130, 246, 0.65);
            box-shadow: var(--btn-google-shadow), 0 0 0 3px rgba(59, 130, 246, 0.35);
        }

        .btn-google:active {
            transform: translateY(0);
            background: #f1f5f9;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
        }

        .or-divider {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin: 1.35rem 0 1rem;
            color: rgba(255, 255, 255, 0.55);
            font-size: 0.8125rem;
            font-weight: 500;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        .or-divider::before,
        .or-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        }
        
        .auth-link {
            text-align: center;
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .auth-link p {
            color: rgba(255, 255, 255, 0.7);
            margin: 0;
            font-size: 0.9rem;
        }
        
        .auth-link a {
            color: #ffffff;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .auth-link a:hover {
            color: rgba(255, 255, 255, 0.9);
            text-decoration: underline;
        }
        
        .alert {
            background: rgba(239, 68, 68, 0.2);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #ffffff;
            border-radius: 0.75rem;
            padding: 1rem;
            margin-bottom: 1.5rem;
        }
        
        .alert-success {
            background: rgba(16, 185, 129, 0.2);
            border-color: rgba(16, 185, 129, 0.3);
        }
        
        .alert-danger {
            background: rgba(239, 68, 68, 0.2);
            border-color: rgba(239, 68, 68, 0.3);
        }
        
        .btn-close {
            filter: invert(1);
        }
        
        @media (max-width: 768px) {
            .auth-container {
                flex-direction: column;
                gap: 2rem;
                padding: 2rem 1.5rem;
            }
            
            .divider {
                width: 100%;
                height: 1px;
                margin: 0;
            }
            
            .logo-section img {
                max-width: 150px;
            }
            
            .auth-header h1 {
                font-size: 1.75rem;
            }
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}

{% block body %}
<div class="auth-wrapper">
    <div class="auth-container">
        <div class="logo-section">
            <img src="{{ asset('images/logo.png') }}" alt="Logo" />
        </div>
        
        <div class="divider"></div>
        
        <div class="auth-form">
            <div class="auth-header">
                <h1>Welcome Back</h1>
                <p>Sign in to your account</p>
            </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% if app.session.get('google_auth_error') %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        {{ app.session.get('google_auth_error') }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% do app.session.remove('google_auth_error') %}
{% endif %}

        {% if error %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                {{ error.messageKey|trans(error.messageData, 'security') }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endif %}

        <form action="{{ path('login') }}" method="post">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="mb-4">
                <label for="email" class="form-label">Email</label>
                <input type="email" 
                       name="_username" 
                       id="email" 
                       class="form-control" 
                       value="{{ last_username }}" 
                       required 
                       autofocus
                       placeholder="Enter your email">
            </div>

            <div class="mb-4">
                <label for="password" class="form-label">Password</label>
                <input type="password" 
                       name="_password" 
                       id="password" 
                       class="form-control" 
                       required
                       placeholder="Enter your password">
            </div>

            <button type="submit" class="btn btn-login">Log In</button>
        </form>

        <div class="or-divider">or</div>

        <a href="{{ path('google_auth_start') }}" class="btn-google" role="button">
            <span class="btn-google__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 48 48" focusable="false">
                <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
                <path fill="#FF3D00" d="m6.306 14.691 6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/>
                <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238A11.91 11.91 0 0 1 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
                <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 0 1-4.087 5.571l.003-.002 6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
            </svg>
            </span>
            <span class="btn-google__label">Continue with Google</span>
        </a>

            <div class="auth-link">
                <p>Don't have an account? <a href="{{ path('app_register') }}">Sign up</a></p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

