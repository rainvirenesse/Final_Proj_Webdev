{% extends 'admin/partials/layout.html.twig' %}

{% block title %}Order Details{% endblock %}

{% block body %}
<div class="container-fluid py-3 admin-workspace">
    <div class="row">
        <div class="col-12 admin-detail-panel">
            <div class="card shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0 fw-semibold">Order Details: {{ order.orderNumber }}</h5>
                </div>
                <div class="card-body p-4">
                    <table class="table table-borderless mb-0 show-details-table">
                        <tr>
                            <th width="30%" class="text-muted fw-semibold">Order Number:</th>
                            <td class="fw-medium">{{ order.orderNumber }}</td>
                        </tr>
                        <tr>
                            <th class="text-muted fw-semibold">Client:</th>
                            <td>{{ order.client.email }}</td>
                        </tr>
                        <tr>
                            <th class="text-muted fw-semibold">Status:</th>
                            <td>
                                <span class="badge {{ order.status == 'COMPLETED' ? 'badge-admin-success' : (order.status == 'CANCELLED' ? 'badge-admin-danger' : (order.status == 'IN_PROGRESS' ? 'badge-admin-info' : 'badge-admin-warning')) }} px-3 py-1">
                                    {{ order.status }}
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted fw-semibold">Payment Status:</th>
                            <td>
                                <span class="badge {{ order.paymentStatus == 'PAID' ? 'badge-admin-success' : (order.paymentStatus == 'PARTIALLY_PAID' ? 'badge-admin-warning' : 'badge-admin-danger') }} px-3 py-1">
                                    {{ order.paymentStatus }}
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <th class="text-muted fw-semibold">Total Price:</th>
                            <td class="fw-semibold text-success fs-5">₱{{ order.totalPrice|number_format(2, '.', ',') }}</td>
                        </tr>
                        <tr>
                            <th class="text-muted fw-semibold">Order Date:</th>
                            <td>{{ order.orderedAt|date('Y-m-d H:i:s') }}</td>
                        </tr>
                        {% if order.completedAt %}
                        <tr>
                            <th class="text-muted fw-semibold">Completed Date:</th>
                            <td>{{ order.completedAt|date('Y-m-d H:i:s') }}</td>
                        </tr>
                        {% endif %}
                        {% if order.notes %}
                        <tr>
                            <th class="text-muted fw-semibold">Notes:</th>
                            <td>{{ order.notes }}</td>
                        </tr>
                        {% endif %}
                    </table>
                </div>
                <div class="card-footer bg-white border-top">
                    <div class="d-flex gap-2">
                        <a href="{{ path('staff_customer_order_index') }}" class="btn btn-outline-secondary">← Back to list</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .show-details-table tr {
        border-bottom: 1px solid var(--admin-border-lighter);
        transition: background-color 0.2s ease;
    }
    .show-details-table tr:hover {
        background-color: var(--admin-bg-light);
    }
    .show-details-table tr:last-child {
        border-bottom: none;
    }
    .show-details-table th {
        padding: 1rem 1.25rem 1rem 0;
        vertical-align: middle;
    }
    .show-details-table td {
        padding: 1rem 0;
        vertical-align: middle;
        color: var(--admin-text-dark);
    }
    .card {
        border: 1px solid var(--admin-border);
        border-radius: 0.5rem;
    }
    .card-header {
        padding: 1.25rem 1.5rem;
    }
    .card-footer {
        padding: 1.25rem 1.5rem;
    }
</style>
{% endblock %}

