{% extends 'admin/partials/layout.html.twig' %}

{% block title %}New User{% endblock %}

{% block body %}
<div class="container-fluid py-3 admin-workspace">
    <div class="row">
        <div class="col-12 admin-detail-panel">
            <div class="card shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0 fw-semibold">Create New User</h5>
                </div>
                <div class="card-body p-4">
                    {{ include('admin/user/_form.html.twig') }}
                </div>
            </div>
            <div class="mt-3">
                <a href="{{ path('staff_user_index') }}" class="btn btn-outline-secondary">← Back to list</a>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border: 1px solid var(--admin-border);
        border-radius: 0.5rem;
    }
    .card-header {
        padding: 1.25rem 1.5rem;
    }
</style>
{% endblock %}

