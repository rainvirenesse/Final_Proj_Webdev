{% extends 'admin/partials/layout.html.twig' %}

{% block title %}Services{% endblock %}

{% block body %}
<div class="container-fluid py-3 admin-workspace">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4">Services</h1>
        <a href="{{ path('staff_service_new') }}" class="btn btn-dark">+ Add New Service</a>
    </div>
    
    {% set headers = ['ID', 'Name', 'Price', 'Duration (Hours)', 'Status', 'Revisions', 'Created', 'Actions'] %}
    {% set rows = [] %}
    
    {% for service in services %}
        {% set statusBadge = '<span class="badge ' ~ 
            (service.status == 'ACTIVE' ? 'badge-admin-success' : 
             (service.status == 'COMPLETED' ? 'badge-admin-info' : 'badge-admin-warning')) ~ 
            '">' ~ service.status ~ '</span>' %}
        {% set createdByStaff = service.createdBy and 'ROLE_STAFF' in service.createdBy.getRoles() %}
        {% set row = {
            'id': service.id,
            'data': [
                service.id,
                service.name,
                '₱' ~ service.price|number_format(2, '.', ','),
                service.durationInHours,
                statusBadge,
                service.revisions,
                service.createdAt|date('Y-m-d')
            ],
            'canEdit': createdByStaff
        } %}
        {% set rows = rows|merge([row]) %}
    {% endfor %}
    
    <div class="card shadow-sm mb-4 admin-datatable-card">
        <div class="card-body p-0 admin-table-scroll admin-table-scroll--inset">
            <table id="servicesTable" class="w-full">
                <thead>
                    <tr>
                        {% for header in headers %}
                            <th class="text-left">{{ header }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            {% for cell in row.data %}
                                <td>{{ cell|raw }}</td>
                            {% endfor %}
                            <td style="white-space: nowrap;">
                                <div class="d-flex gap-1">
                                    <a href="{{ path('staff_service_show', {'id': row.id}) }}" 
                                       class="btn btn-sm btn-outline-secondary">
                                        View
                                    </a>
                                    {% if row.canEdit %}
                                        {# Only show edit/delete for staff-created services #}
                                        <a href="{{ path('staff_service_edit', {'id': row.id}) }}" 
                                           class="btn btn-sm btn-dark">
                                            Edit
                                        </a>
                                        <form method="post"
                                              action="{{ path('staff_service_delete', {'id': row.id}) }}"
                                              class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ row.id) }}">
                                            <button type="submit"
                                                    onclick="return confirm('Are you sure you want to delete this service?');"
                                                    class="btn btn-sm btn-danger">
                                                Delete
                                            </button>
                                        </form>
                                    {% else %}
                                        <span class="text-muted small">Admin Created</span>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* Modern sharp design with subtle shadows */
    #servicesTable {
        border: none !important;
        border-collapse: separate !important;
        border-spacing: 0 !important;
    }

    #servicesTable thead th {
        border: none !important;
        background: linear-gradient(180deg, var(--rain-blush) 0%, var(--rain-warm-white) 55%, #f7f0ec 100%) !important;
        color: var(--rain-wine-dark) !important;
        font-weight: 600;
        font-size: 0.8125rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 1rem 1.25rem;
        position: relative;
        box-shadow: inset 0 -1px 0 rgba(122, 37, 53, 0.15);
        text-shadow: none;
    }

    #servicesTable thead th:first-child {
        padding-left: 1.85rem;
        border-radius: 0.5rem 0 0 0;
    }

    #servicesTable thead th:not(:last-child) {
        box-shadow: inset -1px 0 0 rgba(122, 37, 53, 0.12), inset 0 -1px 0 rgba(122, 37, 53, 0.15);
    }

    #servicesTable thead th:last-child {
        border-radius: 0 0.5rem 0 0;
    }

    #servicesTable thead th.sorting:before,
    #servicesTable thead th.sorting:after,
    #servicesTable thead th.sorting_asc:before,
    #servicesTable thead th.sorting_asc:after,
    #servicesTable thead th.sorting_desc:before,
    #servicesTable thead th.sorting_desc:after {
        color: var(--rain-wine) !important;
        opacity: 0.65;
    }

    #servicesTable tbody td {
        border: none !important;
        border-bottom: 1px solid #f1f3f5 !important;
        padding: 1rem 1.25rem;
        font-size: 0.9375rem;
        color: var(--admin-text-dark);
    }

    #servicesTable tbody tr {
        border: none !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        background-color: var(--admin-white);
    }

    #servicesTable tbody tr:hover {
        background-color: #f8fafc !important;
        transform: translateX(2px);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    #servicesTable tbody tr:last-child td {
        border-bottom: none !important;
    }

    #servicesTable tbody tr:last-child td:first-child {
        border-radius: 0 0 0 0.5rem;
    }

    #servicesTable tbody tr:last-child td:last-child {
        border-radius: 0 0 0.5rem 0;
    }

    .dataTables_wrapper {
        border: none !important;
    }

    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter,
    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate {
        color: var(--admin-text-dark);
        font-size: 0.875rem;
    }

    .dataTables_wrapper .dataTables_length {
        float: left;
        padding: 1rem 1.5rem;
    }

    .dataTables_wrapper .dataTables_filter {
        float: right;
        padding: 1rem 1.5rem;
    }

    .dataTables_wrapper .dataTables_filter input {
        margin-left: 0.5rem;
        padding: 0.375rem 0.75rem;
        border: 1px solid var(--admin-border-light);
        border-radius: 0.375rem;
        font-size: 0.875rem;
    }

    .dataTables_wrapper .dataTables_filter input:focus {
        outline: none;
        border-color: var(--admin-table-header);
    }

    .dataTables_wrapper .dataTables_length select {
        padding: 0.375rem 2rem 0.375rem 0.75rem;
        border: 1px solid var(--admin-border-light);
        border-radius: 0.375rem;
        font-size: 0.875rem;
        margin: 0 0.5rem;
    }

    .dataTables_wrapper .dataTables_info {
        float: left;
        padding: 1rem 1.5rem;
        color: var(--admin-text-muted);
    }

    .dataTables_wrapper .dataTables_paginate {
        float: right;
        padding: 1rem 1.5rem;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button.current {
        background: var(--admin-table-header) !important;
        border-color: var(--admin-table-header) !important;
        color: var(--admin-text-white) !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button:hover:not(.disabled) {
        background: var(--admin-table-header-hover) !important;
        border-color: var(--admin-table-header-hover) !important;
        color: var(--admin-text-white) !important;
    }

    .dataTables_wrapper::after {
        content: "";
        display: table;
        clear: both;
    }

    .card {
        border: 1px solid var(--admin-border);
        border-radius: 0.5rem;
        overflow: hidden;
    }

    #servicesTable th:last-child,
    #servicesTable td:last-child {
        width: 1%;
        white-space: nowrap;
    }
    
    #servicesTable .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
        line-height: 1.5;
        margin: 0 2px;
    }
    
    #servicesTable .d-flex.gap-1 > * {
        margin-right: 0.25rem;
    }
    
    #servicesTable .d-flex.gap-1 > *:last-child {
        margin-right: 0;
    }
</style>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
    window.addEventListener('load', function() {
        function initTable() {
            if (typeof jQuery !== 'undefined' && typeof jQuery.fn !== 'undefined' && typeof jQuery.fn.DataTable !== 'undefined') {
                var $table = jQuery('#servicesTable');
                if ($table.length > 0 && !jQuery.fn.DataTable.isDataTable('#servicesTable')) {
                    $table.DataTable({
                        "pageLength": 10,
                        "lengthMenu": [[5, 10, 25, 50, -1], [5, 10, 25, 50, "All"]],
                        "ordering": true,
                        "order": [[0, "asc"]],
                        "searching": true,
                        "paging": true,
                        "info": true,
                        "autoWidth": false,
                        "responsive": false,
                        "scrollX": true,
                        "scrollCollapse": true,
                        "language": {
                            "search": "Search:",
                            "lengthMenu": "Show _MENU_ entries",
                            "info": "Showing _START_ to _END_ of _TOTAL_ entries",
                            "infoEmpty": "Showing 0 to 0 of 0 entries",
                            "infoFiltered": "(filtered from _MAX_ total entries)",
                            "zeroRecords": "No matching records found",
                            "emptyTable": "No data available in table",
                            "paginate": {
                                "first": "First",
                                "last": "Last",
                                "next": "Next",
                                "previous": "Previous"
                            }
                        },
                        "dom": '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>rt<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                        "columnDefs": [
                            {
                                "targets": -1,
                                "orderable": false,
                                "searchable": false
                            }
                        ]
                    });
                }
            } else {
                setTimeout(initTable, 100);
            }
        }
        initTable();
    });
</script>
{% endblock %}

