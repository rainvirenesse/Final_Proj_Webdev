# Copy to .env.local for local development, or set these variables in Railway (no .env file needed on the server).

###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
# Generate: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=change-me-to-a-random-32-char-secret
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Railway: link a MySQL service and set DATABASE_URL to the provided MYSQL_URL, or:
# mysql://${{MYSQLUSER}}:${{MYSQLPASSWORD}}@${{MYSQLHOST}}:${{MYSQLPORT}}/${{MYSQLDATABASE}}?serverVersion=8.0&charset=utf8mb4
DATABASE_URL="mysql://user:password@127.0.0.1:3306/rain_db?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> app ###
# Public URL of this deployment (HTTPS on Railway). Used for product imageUrl in API responses.
APP_URL=https://your-app.up.railway.app
# Symfony router default URI (CLI, emails). Should match APP_URL.
DEFAULT_URI=https://your-app.up.railway.app
###< app ###

###> nelmio/cors-bundle ###
# React Native does not send Origin; this mainly affects Expo web / browser clients.
CORS_ALLOW_ORIGIN='^https?://.*'
###< nelmio/cors-bundle ###

###> google oauth ###
# Web staff dashboard OAuth (KnpU bundle — /auth/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-app.up.railway.app/auth/google/callback
# CREDO mobile app Google Sign-In (Firebase project appdev-9031a).
# Defaults are baked into config/services.yaml if these are unset.
GOOGLE_MOBILE_WEB_CLIENT_ID=860169035588-pnui8nmbvno853fn3pnk1419f2rfbepo.apps.googleusercontent.com
GOOGLE_MOBILE_ANDROID_CLIENT_ID=860169035588-khejo2nb1ksbs5rsp5s355mtfatfg1vb.apps.googleusercontent.com
###< google oauth ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me-to-a-long-random-passphrase
# Optional: base64-encoded PEM contents (recommended on Railway so keys survive redeploys).
# JWT_PRIVATE_KEY_B64=
# JWT_PUBLIC_KEY_B64=
###< lexik/jwt-authentication-bundle ###

###> realtime websocket (CREDO realtime-ws hub) ###
# Symfony POSTs here after cart/order changes; hub fans out to dashboard + mobile clients.
REALTIME_WS_BROADCAST_URL=http://127.0.0.1:8091/broadcast
REALTIME_WS_BROADCAST_KEY=credo-dev-broadcast-key
# Admin dashboard + mobile WebSocket URL (docker maps 8091→8090).
REALTIME_WS_PUBLIC_URL=ws://127.0.0.1:8091
###< realtime websocket ###

###> symfony/mercure-bundle ###
# Symfony publishes to the hub (server-side). Use the Docker service name when Symfony runs in Docker.
# Local Symfony on host + Mercure in Docker:
MERCURE_URL=http://127.0.0.1:9090/.well-known/mercure
# Browsers / React Native subscribe here (must be reachable from the client device).
MERCURE_PUBLIC_URL=http://127.0.0.1:9090/.well-known/mercure
# Same value as MERCURE_PUBLISHER_JWT_KEY / MERCURE_SUBSCRIBER_JWT_KEY in docker-compose mercure service.
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
# Topic prefix for /orders and /orders/{id}/status (defaults to APP_URL).
# MERCURE_TOPIC_BASE=http://127.0.0.1:8000
###< symfony/mercure-bundle ###
